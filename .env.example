# Copy to .env.local and fill in what you have.
# Everything is optional: Atlas runs fully with no keys.

# --- Real AI chief of staff (first configured provider wins; falls back to rules when none work) ---
# GEMINI_API_KEY=AIza...            # Google AI Studio key; default model gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Gmail + Calendar (Google Cloud Console → OAuth client, web application) ---
# Scopes: gmail.readonly, calendar.readonly
# The redirect URI must be registered in the console; default assumes dev on port 3000:
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
